{
  "name": "simple-vue-components",
  "version": "0.0.2",
  "type": "module",
  "main": "./dist/simple-vue-components.umd.cjs",
  "module": "./dist/simple-vue-components.js",
  "exports": {
    ".": {
      "import": "./dist/simple-vue-components.js",
      "require": "./dist/simple-vue-components.umd.cjs"
    },
    "./style.css": "./dist/simple-vue-components.css"
  },
  "files": [
    "dist",
    "skills",
    "bin"
  ],
  "bin": {
    "simple-vue-components": "./bin/cli.mjs"
  },
  "scripts": {
    "index": "node scripts/generate-index.mjs",
    "stories": "node scripts/generate-stories.mjs",
    "build": "npm run index && vite build",
    "prepack": "npm run build",
    "postinstall": "node bin/postinstall.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/vue3-vite": "^10.6.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "playwright": "latest",
    "storybook": "^10.6.0",
    "vite": "6.4.3",
    "vitest": "latest",
    "vue": "^3.4.0"
  }
}
